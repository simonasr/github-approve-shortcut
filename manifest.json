{
  "manifest_version": 3,
  "name": "Github Approve Shortcut",
  "version": "1.0",
  "description": "Hate your mouse? Me too!",
  "permissions": [],
  "host_permissions": ["https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["content.js"]
    }
  ]
}

